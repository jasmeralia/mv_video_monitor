# Path to the YAML config file inside the container
CONFIG_PATH=/config/config.yaml

# Set to true to scrape without writing to the database or sending notifications
DRY_RUN=false

# Set to true to run one poll cycle and exit (useful for cron-based scheduling)
RUN_ONCE=false

# Seconds between poll cycles (default: 86400 = 24 hours)
POLL_INTERVAL_SECONDS=86400

# Random jitter added/subtracted from poll interval (default: 1800 = 30 min)
POLL_JITTER_SECONDS=1800
